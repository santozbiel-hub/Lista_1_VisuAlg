algoritmo "Lista2_Exercicio03"
var
   numero: real
inicio
   escreva("Numero: ")
   leia(numero)

   se numero > 0 entao
      escreval("O numero e positivo.")
   senao
      se numero < 0 entao
         escreval("O numero e negativo.")
      senao
         escreval("O numero e zero.")
      fimse
   fimse
fimalgoritmo
